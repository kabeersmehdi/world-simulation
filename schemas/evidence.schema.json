{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence record",
  "description": "One claim, its evidence label, and the sources behind it.",
  "type": "object",
  "required": ["id", "claim", "label", "countries", "confidence", "sources", "recorded_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ev-[a-z0-9-]+$"},
    "claim": {"type": "string", "minLength": 10},
    "label": {"type": "string", "enum": ["established_fact", "official_position", "observed_behavior", "evidence_backed_inference", "hypothesis", "speculation"]},
    "countries": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["united-states", "israel", "iran", "other"]}},
    "topics": {"type": "array", "items": {"type": "string"}},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "evidence_against": {"type": "string"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "publisher", "accessed_at", "kind"],
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "publisher": {"type": "string", "minLength": 2},
          "published_at": {"type": ["string", "null"], "format": "date"},
          "accessed_at": {"type": "string", "format": "date"},
          "kind": {"type": "string", "enum": ["primary", "official", "independent_reporting", "reference", "research", "unverified_signal"]}
        }
      }
    }
  }
}
