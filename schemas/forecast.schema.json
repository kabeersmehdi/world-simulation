{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forecast",
  "description": "A precise, testable question with an append-only probability history.",
  "type": "object",
  "required": [
    "id",
    "question",
    "resolution_criteria",
    "countries",
    "topic",
    "created_at",
    "deadline",
    "status",
    "illustrative",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fc-[a-z0-9-]+$"
    },
    "question": {
      "type": "string",
      "minLength": 15
    },
    "resolution_criteria": {
      "type": "string",
      "minLength": 20
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "united-states",
          "israel",
          "iran",
          "other"
        ]
      }
    },
    "topic": {
      "type": "string",
      "enum": [
        "election",
        "coalition",
        "military",
        "diplomacy",
        "aid-and-arms",
        "sanctions",
        "economy",
        "other"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "annulled"
      ]
    },
    "illustrative": {
      "type": "boolean"
    },
    "reference_class": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "description",
        "base_rate"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10
        },
        "base_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "baserate_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "indicators_to_watch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raise_if": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lower_if": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "market": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "slug"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "polymarket"
          ]
        },
        "slug": {
          "type": "string",
          "minLength": 3
        },
        "outcome_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "at",
          "probability",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "benchmark_probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "resolution": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "outcome",
        "resolved_at",
        "source_url"
      ],
      "properties": {
        "outcome": {
          "type": "boolean"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "post_mortem": {
          "type": "string"
        }
      }
    },
    "exclusive_group": {
      "type": [
        "string",
        "null"
      ],
      "description": "Forecasts in one group cannot both resolve yes; their probabilities must sum to at most 1."
    },
    "annulled_reason": {
      "type": "string",
      "minLength": 10,
      "description": "Why an annulled forecast was withdrawn. Annulled forecasts are kept and never scored."
    }
  }
}
