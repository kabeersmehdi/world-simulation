{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observation",
  "description": "One item a collector saw: a headline, a Telegram post, an aircraft, an advisory. Stores a short excerpt and a link, never a full article.",
  "type": "object",
  "required": ["id", "collector", "source_id", "observed_at", "title", "url", "lang", "indicators", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ob-[0-9a-f]{16}$"},
    "collector": {"type": "string", "enum": ["rss", "telegram", "adsb", "fleet", "advisory", "gpsjam", "firms"]},
    "source_id": {"type": "string", "minLength": 2},
    "observed_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "title": {"type": "string", "minLength": 1},
    "excerpt": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "lang": {"type": "string", "enum": ["he", "en", "ar", "fa", "data"]},
    "indicators": {"type": "array", "items": {"type": "string", "enum": ["airspace", "home_front", "reserves", "us_advisory", "us_military_moves", "late_night_cabinet", "gps_jamming", "infrastructure_fire"]}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "data": {"type": ["object", "null"]}
  }
}
